# ---- Nyra Service Tool :: environment template ---------------------------------
# Copy to .env and fill locally. NEVER commit .env and never paste real values in chat.

# --- database -------------------------------------------------------------------
# Local docker fallback (docker compose up postgres) -> port 5433
DATABASE_URL=postgresql://nyra:nyra@localhost:5433/nyra
# Supabase: Settings -> Database -> Connection string (URI)
# SUPABASE_DB_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# --- supabase auth --------------------------------------------------------------
AUTH_MODE=dev                     # dev | supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# --- app ------------------------------------------------------------------------
APP_ENV=dev
SECRET_KEY=change-me-generate-with--openssl-rand-hex-32
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
DEFAULT_TENANT_SLUG=nyra-demo

# --- ai (day 12) ----------------------------------------------------------------
LLM_PROVIDER=                     # gemini | fireworks | openrouter | openai | anthropic | ollama
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
AI_ENABLED=false
AI_AUTONOMY_TIER=2

# --- email (day 8-9) ------------------------------------------------------------
SMTP_HOST=                        # smtp.gmail.com | smtp.resend.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=helpdesk@example.com
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX

# --- web ------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE=http://localhost:8000
